# External Storage Service Configuration
# =======================================
#
# All settings can also be overridden via environment variables.
#
# Server settings
# ---------------
# listen: "http://*:8080"        # ESS_LISTEN

# Storage backend type: Disk, AmazonS3, or Dropbox
# -------------------------------------------------
storage_type: Disk               # STORAGE_TYPE

# Disk backend settings
# ---------------------
storage_path: /var/attachments   # STORAGE_PATH

# AmazonS3 backend settings
# --------------------------
# storage_type: AmazonS3
# s3_access_key_id: "YOUR_ACCESS_KEY"       # S3_ACCESS_KEY_ID
# s3_secret_access_key: "YOUR_SECRET_KEY"   # S3_SECRET_ACCESS_KEY
# s3_bucket: "my-rt-attachments"            # S3_BUCKET
# s3_host: "s3.amazonaws.com"               # S3_HOST (optional)
# s3_region: "us-east-1"                    # S3_REGION (optional)

# Dropbox backend settings
# -------------------------
# storage_type: Dropbox
# dropbox_app_key: "YOUR_APP_KEY"           # DROPBOX_APP_KEY
# dropbox_app_secret: "YOUR_APP_SECRET"     # DROPBOX_APP_SECRET
# dropbox_refresh_token: "YOUR_TOKEN"       # DROPBOX_REFRESH_TOKEN
